# RIFAD Backend Environment Configuration
# Copy this file to .env and fill in real values locally. Never commit .env.
#
# In production (NODE_ENV=production), COOKIE_SECRET, PII_ENCRYPTION_KEY, and
# BLIND_INDEX_SALT are validated at startup (src/config/env.js): each must be
# set, non-blank, at least 32 characters long, and different from any known
# development default. The application will refuse to start otherwise.

# Runtime
NODE_ENV=development
PORT=3000

# Database (Neon PostgreSQL / Prisma)
DATABASE_URL=
DIRECT_URL=

# Session Cookie
SESSION_COOKIE_NAME=rifad_session
SESSION_TTL_DAYS=7

# CORS
CORS_ORIGIN=http://localhost:3000

# Security Secrets (required, >= 32 characters, unique per environment)
# Generate strong random values locally, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=
PII_ENCRYPTION_KEY=
BLIND_INDEX_SALT=
